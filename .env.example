# Copia este archivo a .env y completa valores solo para tu entorno local.
DB_URL=jdbc:mysql://localhost:3306/gestor_contactos?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=usuario_local
DB_PASSWORD=cambia_esta_clave

SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
API_PREFIX=/api/v1

CONTACT_PHOTO_DIRECTORY=./uploads/contactos
PHOTO_MAX_BYTES=2097152
UPLOAD_MAX_FILE_SIZE=2MB
UPLOAD_MAX_REQUEST_SIZE=3MB

# Reemplaza por una clave aleatoria de al menos 32 bytes antes de iniciar la API.
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
JWT_EXPIRATION_MS=86400000

# La contraseña solo se usa al crear la cuenta inicial, si todavía no existe.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=REEMPLAZAR_POR_CLAVE_LOCAL_SEGURA

# Configuración local de esquema. En producción, aprovisionar la BD por separado.
SQL_INIT_MODE=always
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
